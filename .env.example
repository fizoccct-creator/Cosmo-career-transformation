# Copy this file to .env and fill in your key. Never commit .env to GitHub.

# Get a key at https://aistudio.google.com/apikey  (leave empty to run without AI: template portraits only)
GEMINI_API_KEY=

# Image model. If Google renames it and you see "model not found", put the current name here.
GEMINI_MODEL=gemini-2.5-flash-image

# Portrait shape sent to the AI
PORTRAIT_ASPECT_RATIO=4:5

# Port for http://localhost:PORT
PORT=3000
